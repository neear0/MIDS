# Copy to .env and adjust. All variables use the EFAKTURA_ prefix.
EFAKTURA_ENVIRONMENT=development
EFAKTURA_DATABASE_URL=postgresql+psycopg://efaktura:efaktura@localhost:5432/efaktura
EFAKTURA_JWT_SECRET=generate-with-openssl-rand-hex-32
# Fernet key for encrypting SuperFaktúra/AP credentials:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
EFAKTURA_SECRETS_KEY=
EFAKTURA_CORS_ORIGINS=["http://localhost:3000"]
EFAKTURA_SCHEMATRON_DIR=./validation-artifacts

# AI extraction: heuristic (offline, PDFs with text) | anthropic (scans/photos via Claude)
EFAKTURA_EXTRACTION_PROVIDER=heuristic
EFAKTURA_ANTHROPIC_API_KEY=
EFAKTURA_ANTHROPIC_MODEL=claude-opus-5

# Peppol Access Point partner: mock | http
EFAKTURA_PEPPOL_PROVIDER=mock
EFAKTURA_PEPPOL_API_URL=
EFAKTURA_PEPPOL_API_KEY=
